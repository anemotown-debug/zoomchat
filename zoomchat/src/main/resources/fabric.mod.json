{
  "schemaVersion": 1,
  "id": "zoomchat",
  "version": "${version}",
  "name": "Zoom & Chat Preview",
  "description": "Hold C to zoom. Hold Z to preview chat without opening it.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.zoomchat.ZoomChatClient"]
  },
  "mixins": [
    { "config": "zoomchat.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "26.3.*",
    "java": ">=25"
  }
}
